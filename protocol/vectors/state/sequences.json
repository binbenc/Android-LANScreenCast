{
  "description": "Session state machine sequences. Event syntax: 'open', 'lost', 'connecting', 'sent:<TYPE>', 'recv:<TYPE>[:trusted][:confirm][:resumeOk][:fatal|:nonfatal]', 'auth', 'media-up', 'media-down', 'exhausted'. 'expect' lists the state after each event; 'rejected' (optional) lists indexes whose event must be rejected.",
  "cases": [
    {"name": "sender-trusted-happy-path", "role": "SENDER",
     "events": ["connecting", "open", "sent:HELLO", "recv:HELLO:trusted", "sent:OFFER", "recv:ANSWER", "sent:ICE", "recv:ICE", "media-up", "sent:BYE"],
     "expect": ["CONNECTING", "CONNECTING", "HELLO_SENT", "AUTHENTICATED", "NEGOTIATING", "NEGOTIATING", "NEGOTIATING", "NEGOTIATING", "STREAMING", "CLOSED"]},
    {"name": "sender-pairing", "role": "SENDER",
     "events": ["connecting", "open", "sent:HELLO", "recv:HELLO", "sent:PAIR_REQ", "sent:PAIR_PIN", "recv:PAIR_PIN", "sent:PAIR_CONFIRM", "recv:PAIR_OK", "sent:OFFER"],
     "expect": ["CONNECTING", "CONNECTING", "HELLO_SENT", "PAIRING", "PAIRING", "PAIRING", "PAIRING", "PAIRING", "AUTHENTICATED", "NEGOTIATING"]},
    {"name": "sender-trusted-but-confirm", "role": "SENDER",
     "events": ["connecting", "open", "sent:HELLO", "recv:HELLO:trusted:confirm", "sent:PAIR_REQ", "recv:PAIR_OK"],
     "expect": ["CONNECTING", "CONNECTING", "HELLO_SENT", "PAIRING", "PAIRING", "AUTHENTICATED"]},
    {"name": "receiver-rejects-offer-before-auth", "role": "RECEIVER",
     "events": ["open", "recv:HELLO", "recv:OFFER"],
     "expect": ["AWAIT_HELLO", "PAIRING", "CLOSED"], "rejected": [2]},
    {"name": "receiver-rejects-ice-before-hello", "role": "RECEIVER",
     "events": ["open", "recv:ICE"],
     "expect": ["AWAIT_HELLO", "CLOSED"], "rejected": [1]},
    {"name": "receiver-pin-mismatch-is-not-fatal", "role": "SENDER",
     "events": ["connecting", "open", "sent:HELLO", "recv:HELLO", "sent:PAIR_PIN", "recv:ERROR:nonfatal", "sent:PAIR_PIN"],
     "expect": ["CONNECTING", "CONNECTING", "HELLO_SENT", "PAIRING", "PAIRING", "PAIRING", "PAIRING"]},
    {"name": "receiver-trusted-path", "role": "RECEIVER",
     "events": ["open", "recv:HELLO:trusted", "sent:HELLO", "recv:OFFER", "sent:ANSWER", "media-up", "recv:BYE"],
     "expect": ["AWAIT_HELLO", "AUTHENTICATED", "AUTHENTICATED", "NEGOTIATING", "NEGOTIATING", "STREAMING", "CLOSED"]},
    {"name": "receiver-pairing-then-auth", "role": "RECEIVER",
     "events": ["open", "recv:HELLO", "sent:HELLO", "recv:PAIR_REQ", "recv:PAIR_PIN", "sent:PAIR_PIN", "recv:PAIR_CONFIRM", "sent:PAIR_OK", "recv:OFFER"],
     "expect": ["AWAIT_HELLO", "PAIRING", "PAIRING", "PAIRING", "PAIRING", "PAIRING", "PAIRING", "AUTHENTICATED", "NEGOTIATING"]},
    {"name": "sender-reconnect-resume", "role": "SENDER",
     "events": ["connecting", "open", "sent:HELLO", "recv:HELLO:trusted", "sent:OFFER", "media-up", "lost", "connecting", "open", "sent:HELLO", "recv:HELLO:resumeOk", "sent:OFFER", "recv:ANSWER", "media-up"],
     "expect": ["CONNECTING", "CONNECTING", "HELLO_SENT", "AUTHENTICATED", "NEGOTIATING", "STREAMING", "RECONNECTING", "RECONNECTING", "RECONNECTING", "RESUMING", "NEGOTIATING", "NEGOTIATING", "NEGOTIATING", "STREAMING"]},
    {"name": "sender-reconnect-refused", "role": "SENDER",
     "events": ["connecting", "open", "sent:HELLO", "recv:HELLO:trusted", "sent:OFFER", "media-up", "lost", "open", "sent:HELLO", "recv:HELLO"],
     "expect": ["CONNECTING", "CONNECTING", "HELLO_SENT", "AUTHENTICATED", "NEGOTIATING", "STREAMING", "RECONNECTING", "RECONNECTING", "RESUMING", "CLOSED"]},
    {"name": "sender-reconnect-exhausted", "role": "SENDER",
     "events": ["connecting", "open", "sent:HELLO", "recv:HELLO:trusted", "sent:OFFER", "media-up", "lost", "exhausted"],
     "expect": ["CONNECTING", "CONNECTING", "HELLO_SENT", "AUTHENTICATED", "NEGOTIATING", "STREAMING", "RECONNECTING", "CLOSED"]},
    {"name": "ice-only-drop-keeps-signaling", "role": "SENDER",
     "events": ["connecting", "open", "sent:HELLO", "recv:HELLO:trusted", "sent:OFFER", "media-up", "media-down", "sent:OFFER", "recv:ANSWER", "media-up"],
     "expect": ["CONNECTING", "CONNECTING", "HELLO_SENT", "AUTHENTICATED", "NEGOTIATING", "STREAMING", "NEGOTIATING", "NEGOTIATING", "NEGOTIATING", "STREAMING"]},
    {"name": "fatal-error-closes", "role": "SENDER",
     "events": ["connecting", "open", "sent:HELLO", "recv:ERROR:fatal"],
     "expect": ["CONNECTING", "CONNECTING", "HELLO_SENT", "CLOSED"]},
    {"name": "lost-before-auth-closes", "role": "RECEIVER",
     "events": ["open", "recv:HELLO", "lost"],
     "expect": ["AWAIT_HELLO", "PAIRING", "CLOSED"]}
  ]
}
