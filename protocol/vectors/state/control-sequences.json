{
  "description": "Reverse-control (F23) sender authorization state machine. Cooldowns: 10 s after deny / timeout / cancel / revoke / unavailable reply; 60 s after the second deny in the same session. The machine starts with availability given by 'initial' ('available' or an unavailable reason). Event syntax: 'avail', 'unavail:<REASON>', 'req:<rid>[:locked]', 'allow', 'deny', 'tick', 'recv-end', 'revoke', 'lock', 'pause:<REASON>', 'resume:<REASON>', 'end', 'wait:<ms>' (advance the clock, no event). 'expect' lists the CTL_STATE.state after each event; 'reason' (optional) lists CTL_STATE.reason after each event (null = absent); 'inject' (optional) lists whether input may be injected after each event. With several pause reasons the shown reason follows the fixed priority OWN_APP > SENSITIVE_APP > PROTECTED > WINDOWED > APP_HIDDEN > RECONNECTING.",
  "cases": [
    {"name": "happy-path-then-revoke", "initial": "available",
     "events": ["req:1", "allow", "revoke"],
     "expect": ["PENDING", "ACTIVE", "IDLE"],
     "reason": [null, null, "REVOKED"],
     "inject": [false, true, false]},
    {"name": "unavailable-setting-off-replies-reason", "initial": "SETTING_OFF",
     "events": ["req:1", "allow"],
     "expect": ["UNAVAILABLE", "UNAVAILABLE"],
     "reason": ["SETTING_OFF", "SETTING_OFF"],
     "inject": [false, false]},
    {"name": "service-turned-off-while-active-ends-control", "initial": "available",
     "events": ["req:1", "allow", "unavail:SERVICE_OFF", "avail"],
     "expect": ["PENDING", "ACTIVE", "UNAVAILABLE", "IDLE"],
     "reason": [null, null, "SERVICE_OFF", "SERVICE_OFF"]},
    {"name": "deny-starts-10s-cooldown", "initial": "available",
     "events": ["req:1", "deny", "wait:5000", "req:2", "wait:5001", "req:3"],
     "expect": ["PENDING", "IDLE", "IDLE", "IDLE", "IDLE", "PENDING"],
     "reason": [null, "USER_DENIED", "USER_DENIED", "COOLDOWN", "COOLDOWN", null]},
    {"name": "confirm-timeout-30s", "initial": "available",
     "events": ["req:1", "wait:29999", "tick", "wait:1", "tick", "allow"],
     "expect": ["PENDING", "PENDING", "PENDING", "PENDING", "IDLE", "IDLE"],
     "reason": [null, null, null, null, "TIMEOUT", "TIMEOUT"],
     "inject": [false, false, false, false, false, false]},
    {"name": "receiver-cancels-request", "initial": "available",
     "events": ["req:1", "recv-end", "req:2"],
     "expect": ["PENDING", "IDLE", "IDLE"],
     "reason": [null, "CANCELLED", "COOLDOWN"]},
    {"name": "receiver-exits-control-no-cooldown", "initial": "available",
     "events": ["req:1", "allow", "recv-end", "req:2"],
     "expect": ["PENDING", "ACTIVE", "IDLE", "PENDING"],
     "reason": [null, null, "RECEIVER_END", null]},
    {"name": "duplicate-request-is-idempotent", "initial": "available",
     "events": ["req:1", "req:1", "allow", "req:2"],
     "expect": ["PENDING", "PENDING", "ACTIVE", "ACTIVE"]},
    {"name": "reconnect-pauses-and-resumes-without-confirm", "initial": "available",
     "events": ["req:1", "allow", "pause:RECONNECTING", "resume:RECONNECTING"],
     "expect": ["PENDING", "ACTIVE", "PAUSED", "ACTIVE"],
     "reason": [null, null, "RECONNECTING", null],
     "inject": [false, true, false, true]},
    {"name": "multiple-pause-reasons", "initial": "available",
     "events": ["req:1", "allow", "pause:PROTECTED", "pause:APP_HIDDEN", "resume:PROTECTED", "resume:APP_HIDDEN"],
     "expect": ["PENDING", "ACTIVE", "PAUSED", "PAUSED", "PAUSED", "ACTIVE"],
     "reason": [null, null, "PROTECTED", "PROTECTED", "APP_HIDDEN", null]},
    {"name": "pause-condition-before-allow-applies-after", "initial": "available",
     "events": ["pause:WINDOWED", "req:1", "allow", "resume:WINDOWED"],
     "expect": ["IDLE", "PENDING", "PAUSED", "ACTIVE"],
     "reason": [null, null, "WINDOWED", null]},
    {"name": "lock-ends-control-and-does-not-resume", "initial": "available",
     "events": ["req:1", "allow", "lock", "allow"],
     "expect": ["PENDING", "ACTIVE", "IDLE", "IDLE"],
     "reason": [null, null, "LOCKED", "LOCKED"],
     "inject": [false, true, false, false]},
    {"name": "request-while-locked-is-refused", "initial": "available",
     "events": ["req:1:locked", "req:2"],
     "expect": ["IDLE", "PENDING"],
     "reason": ["LOCKED", null]},
    {"name": "revoke-while-pending-counts-as-deny", "initial": "available",
     "events": ["req:1", "revoke", "req:2"],
     "expect": ["PENDING", "IDLE", "IDLE"],
     "reason": [null, "USER_DENIED", "COOLDOWN"]},
    {"name": "second-deny-cooldown-60s", "initial": "available",
     "events": ["req:1", "deny", "wait:10001", "req:2", "deny", "wait:10001", "req:3", "wait:50000", "req:4"],
     "expect": ["PENDING", "IDLE", "IDLE", "PENDING", "IDLE", "IDLE", "IDLE", "IDLE", "PENDING"],
     "reason": [null, "USER_DENIED", "USER_DENIED", null, "USER_DENIED", "USER_DENIED", "COOLDOWN", "COOLDOWN", null]},
    {"name": "unavailable-reply-also-cools-down", "initial": "SERVICE_OFF",
     "events": ["req:1", "avail", "req:2", "wait:10001", "req:3"],
     "expect": ["UNAVAILABLE", "IDLE", "IDLE", "IDLE", "PENDING"],
     "reason": ["SERVICE_OFF", null, "COOLDOWN", "COOLDOWN", null]},
    {"name": "pause-priority-own-app-over-sensitive", "initial": "available",
     "events": ["req:1", "allow", "pause:SENSITIVE_APP", "pause:OWN_APP", "resume:OWN_APP", "pause:RECONNECTING", "resume:SENSITIVE_APP"],
     "expect": ["PENDING", "ACTIVE", "PAUSED", "PAUSED", "PAUSED", "PAUSED", "PAUSED"],
     "reason": [null, null, "SENSITIVE_APP", "OWN_APP", "SENSITIVE_APP", "SENSITIVE_APP", "RECONNECTING"]},
    {"name": "session-end", "initial": "available",
     "events": ["req:1", "allow", "pause:RECONNECTING", "end"],
     "expect": ["PENDING", "ACTIVE", "PAUSED", "IDLE"],
     "reason": [null, null, "RECONNECTING", "SESSION_END"],
     "inject": [false, true, false, false]}
  ]
}
