<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- DLNA 推送（F13，决策 #32）：推送期间文件服务保活；Android 15+ 转换视频时叠加 mediaProcessing（PRD 8.1.1 F2） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 内录声音（AudioPlaybackCapture 系统要求），不打开麦克风；首次开启声音时才申请 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 扫码连接；只在点击“扫码”时申请 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 镜像期间保持亮屏（决策 #17） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application>
        <service
            android:name=".service.ScreenCastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".push.MediaPushService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback|mediaProcessing" />

        <!--
          F14 系统分享菜单“推送到电视”（PRD 8.1.2 B）：独立任务（taskAffinity=""）、不进最近任务，盖在来源 App 上。
          不注册 */*（避免出现在分享 PDF / 文档的面板里）；相册混选时系统可能写成 */*，仍会匹配到这里，逐项按真实类型过滤。
        -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.WscShare"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".tile.CastTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_cast"
            android:label="@string/sender_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
